# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave "anon" é pública por design: quem protege os dados são as regras RLS do banco.
# NUNCA coloque aqui a chave "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
